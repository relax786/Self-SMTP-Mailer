nano .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/

# Databases
*.db
*.sqlite
*.sqlite3

# Environment / secrets
.env
.env.*
!.env.example

# Credentials
credentials.json
secrets.json
tokens.json
*.pem
*.key

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Build
build/
dist/
*.spec

# Temporary files
*.tmp
*.bak
